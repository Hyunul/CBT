# Copy to .env and replace every placeholder. Never commit .env.
DB_PASSWORD=replace-with-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_URL=http://localhost
HTTP_PORT=80
# Enable configured OAuth providers, e.g. prod,oauth-google
SPRING_PROFILES_ACTIVE=prod
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional for pulling CI-built images:
# DOCKER_USERNAME=
# IMAGE_TAG=
# Memory tuning (defaults suit a 4GB host; for a 12GB VM use e.g. -Xms1g -Xmx3g and 3G)
# JAVA_OPTS=-Xms1g -Xmx3g
# MYSQL_INNODB_BUFFER_POOL_SIZE=3G
# Optional monitoring (Prometheus + Grafana, see docs/OPERATIONS.md):
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml:docker-compose.monitoring.yml
# GRAFANA_ADMIN_PASSWORD=replace-with-random-grafana-password
# GRAFANA_PORT=3001
